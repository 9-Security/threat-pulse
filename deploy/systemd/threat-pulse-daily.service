[Unit]
Description=Daily SOC IoC report: collect, mail, push to D1
Documentation=https://github.com/9-Security/threat-pulse
After=network-online.target
Wants=network-online.target

# A missed collection cannot be recovered: source feeds carry only their most
# recent items. Failure has to arrive as a message, because its natural shape is
# an email that does not turn up, and nobody notices an absence -- least of all
# on a weekend, when a thin report looks normal.
OnFailure=threat-pulse-alert@%n.service

[Service]
Type=oneshot
User=threatpulse
Group=threatpulse
WorkingDirectory=/home/threatpulse/app
# Credentials live here, owned by the service user and readable by nobody else.
# The unit fails loudly if it is missing rather than running unconfigured.
EnvironmentFile=/home/threatpulse/threat-pulse.env
ExecStart=/home/threatpulse/app/deploy/run-daily.sh
# 45 minutes was copied from the CI timeout, where minutes are billed. Here they
# are not, and the cost of being wrong is asymmetric: a run killed at the ceiling
# loses articles already collected for a day that cannot be collected again. On
# 2026-09-09 a window with 348 new CVEs spent 43 minutes inside NVD's
# unauthenticated 5-per-30s limit and was killed with nothing written.
#
# Enrichment now stops itself at NVD_BUDGET_SECONDS and reports what it skipped,
# so this ceiling should never be what ends a run. It is the backstop for
# something genuinely stuck, and it is set well clear of any normal day.
TimeoutStartSec=3h

# The job reads public feeds and writes one directory. Nothing else is its
# business, and this host runs other people's services.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/threatpulse/app /home/threatpulse
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
