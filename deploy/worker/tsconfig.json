{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    // enrich.ts imports guard.ts by its file name so node can run its tests unbundled.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  // Tests run under node, not in the Worker: they import node:test and node:assert,
  // which the Worker types deliberately do not describe. Checking them here would
  // mean pulling @types/node into the Worker's type environment to describe code
  // that never ships in the bundle. `npm test` type-strips and runs them instead.
  "exclude": ["src/**/*.test.ts"]
}
